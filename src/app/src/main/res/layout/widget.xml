<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/w_bg" android:layoutDirection="rtl"
    android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wCity" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="13dp" android:textColor="#FFFFFF" android:maxLines="1"
                android:ellipsize="end" android:text="غزة"/>
            <TextView android:id="@+id/wDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12dp" android:textColor="#E0B04E" android:maxLines="1" android:text="10 جمادى الآخرة 1448هـ"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/wMid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginTop="2dp" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/wNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16dp" android:textColor="#FFFFFF" android:layout_marginEnd="8dp" android:text="الفجر بعد"/>
            <Chronometer android:id="@+id/wCount" android:fontFamily="@font/w_digits" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="19dp" android:textStyle="bold" android:textColor="#E0B04E" android:layoutDirection="ltr"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/wGrid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/n0" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12dp" android:textColor="#B3FFFFFF" android:maxLines="1" android:gravity="center"
                    android:includeFontPadding="false" android:text="الفجر"/>
                <TextView android:id="@+id/t0" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15dp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
                    android:layout_marginTop="3dp" android:gravity="center" android:includeFontPadding="false" android:text="4:43"/>
                <ImageView android:id="@+id/u0" android:layout_width="16dp" android:layout_height="2dp"
                    android:layout_marginTop="4dp" android:src="@drawable/w_line" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12dp" android:textColor="#B3FFFFFF" android:maxLines="1" android:gravity="center"
                    android:includeFontPadding="false" android:text="الظهر"/>
                <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15dp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
                    android:layout_marginTop="3dp" android:gravity="center" android:includeFontPadding="false" android:text="11:28"/>
                <ImageView android:id="@+id/u1" android:layout_width="16dp" android:layout_height="2dp"
                    android:layout_marginTop="4dp" android:src="@drawable/w_line" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12dp" android:textColor="#B3FFFFFF" android:maxLines="1" android:gravity="center"
                    android:includeFontPadding="false" android:text="العصر"/>
                <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15dp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
                    android:layout_marginTop="3dp" android:gravity="center" android:includeFontPadding="false" android:text="2:22"/>
                <ImageView android:id="@+id/u2" android:layout_width="16dp" android:layout_height="2dp"
                    android:layout_marginTop="4dp" android:src="@drawable/w_line" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12dp" android:textColor="#B3FFFFFF" android:maxLines="1" android:gravity="center"
                    android:includeFontPadding="false" android:text="المغرب"/>
                <TextView android:id="@+id/t3" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15dp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
                    android:layout_marginTop="3dp" android:gravity="center" android:includeFontPadding="false" android:text="4:45"/>
                <ImageView android:id="@+id/u3" android:layout_width="16dp" android:layout_height="2dp"
                    android:layout_marginTop="4dp" android:src="@drawable/w_line" android:visibility="invisible"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:id="@+id/n4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12dp" android:textColor="#B3FFFFFF" android:maxLines="1" android:gravity="center"
                    android:includeFontPadding="false" android:text="العشاء"/>
                <TextView android:id="@+id/t4" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15dp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"
                    android:layout_marginTop="3dp" android:gravity="center" android:includeFontPadding="false" android:text="6:04"/>
                <ImageView android:id="@+id/u4" android:layout_width="16dp" android:layout_height="2dp"
                    android:layout_marginTop="4dp" android:src="@drawable/w_line" android:visibility="invisible"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="52dp" android:layout_height="70dp"
        android:layout_marginStart="6dp" android:src="@drawable/w_logo" android:alpha="0.16"
        android:scaleType="fitCenter"/>
</LinearLayout>
